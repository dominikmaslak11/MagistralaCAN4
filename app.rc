#include <windows.h>

// Icons
IDI_ICON1 ICON "magistrala.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041504e3"
        BEGIN
            VALUE "CompanyName",      "CustomLabs"
            VALUE "FileDescription",  "MagistralaCAN4 - Sniffer CAN"
            VALUE "FileVersion",      "2.0.0"
            VALUE "InternalName",     "MagistralaCAN4"
            VALUE "LegalCopyright",   "CustomLabs"
            VALUE "OriginalFilename", "MagistralaCAN4.exe"
            VALUE "ProductName",      "MagistralaCAN4"
            VALUE "ProductVersion",   "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x415, 0x4e3
    END
END
