/* ================================================================
   MagistralaCAN4 — Light Theme
   ================================================================ */

QMainWindow {
    background-color: #f5f5f5;
}

QToolBar {
    background: #e8e8e8;
    border-bottom: 2px solid #ccc;
    spacing: 8px;
    padding: 4px;
}

QStatusBar {
    background: #e8e8e8;
    color: #333;
    border-top: 1px solid #ccc;
}

QMenuBar {
    background-color: #e8e8e8;
    color: #333;
}

QMenuBar::item:selected {
    background: #0078d4;
    color: #fff;
}

QMenu {
    background-color: #fff;
    color: #333;
    border: 1px solid #ccc;
}

QMenu::item:selected {
    background-color: #0078d4;
    color: #fff;
}

QTabWidget::pane {
    background-color: #f5f5f5;
    border: 1px solid #ddd;
    border-top: 2px solid #0078d4;
}

QTabBar::tab {
    background: #e0e0e0;
    color: #333;
    border: 1px solid #ccc;
    border-bottom: none;
    padding: 6px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #f5f5f5;
    color: #0078d4;
    font-weight: bold;
    border-bottom: 2px solid #0078d4;
}

QTabBar::tab:hover:!selected {
    background: #ddd;
    color: #0078d4;
}

QPushButton, QToolButton {
    background: #e0e0e0;
    color: #333;
    border: 1px solid #999;
    border-radius: 4px;
    padding: 5px 15px;
    font-weight: bold;
}

QPushButton:hover, QToolButton:hover {
    background: #0078d4;
    color: #fff;
}

QPushButton:pressed, QToolButton:pressed {
    background: #005a9e;
    color: #fff;
}

QPushButton:disabled, QToolButton:disabled {
    background: #eee;
    color: #999;
    border-color: #ccc;
}

QLineEdit, QSpinBox, QDoubleSpinBox {
    background: #fff;
    color: #333;
    border: 1px solid #999;
    border-radius: 4px;
    padding: 4px 8px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #0078d4;
}

QComboBox {
    background: #fff;
    color: #333;
    border: 1px solid #999;
    border-radius: 4px;
    padding: 3px 8px;
    min-width: 100px;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background: #fff;
    color: #333;
    selection-background-color: #0078d4;
    selection-color: #fff;
}

QCheckBox {
    color: #333;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QLabel {
    color: #333;
}

QTableView, QTableWidget {
    background-color: #fff;
    alternate-background-color: #f0f0f0;
    color: #333;
    gridline-color: #ddd;
    selection-background-color: #0078d4;
    selection-color: #fff;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
}

QHeaderView::section {
    background-color: #e0e0e0;
    color: #333;
    font-weight: bold;
    padding: 4px;
    border: none;
    border-bottom: 2px solid #999;
}

QGroupBox {
    color: #0078d4;
    font-weight: bold;
    border: 1px solid #ccc;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QScrollArea {
    background-color: #f5f5f5;
    border: none;
}

QScrollBar:vertical {
    background: #e8e8e8;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #999;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #0078d4;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #e8e8e8;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #999;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QListWidget {
    background-color: #fff;
    color: #333;
    border: 1px solid #ddd;
}

QListWidget::item:selected {
    background: #0078d4;
    color: #fff;
}

QTextEdit, QPlainTextEdit {
    background-color: #fff;
    color: #333;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    border: 1px solid #ddd;
    border-radius: 4px;
}

QFrame[HLine="true"] {
    background-color: #ccc;
}

QToolTip {
    background-color: #fff;
    color: #333;
    border: 1px solid #ccc;
    padding: 4px;
}

QSlider::groove:horizontal {
    background: #ddd;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #0078d4;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: #005a9e;
    border-radius: 3px;
}
