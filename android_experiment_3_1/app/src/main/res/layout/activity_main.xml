<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eksperyment 3.1 — zasieg WiFi/BLE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Technologia -->
        <RadioGroup
            android:id="@+id/radioTech"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/radioTechWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WiFi (SoftAP)"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioTechBle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BLE"
                android:layout_marginStart="24dp" />
        </RadioGroup>

        <!-- Adres ESP32 (SoftAP) - dotyczy tylko WiFi, dla BLE ignorowane (skan po UUID) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Adres IP ESP32 (SoftAP)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editEspIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="192.168.4.1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Port UDP ESP32">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editEspPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="3131" />
        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Dystans / scenariusz -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Odleglosc [m] (recznie zmierzona)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <RadioGroup
            android:id="@+id/radioScenario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/radioLos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOS"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioNlos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NLOS"
                android:layout_marginStart="24dp" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Liczba pakietow do wyslania">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPacketCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="1000" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnSetReference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ustaw punkt bazowy (GPS, zrob to przy ESP32)" />

        <TextView
            android:id="@+id/textReferenceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Punkt bazowy: nie ustawiony" />

        <Button
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Start testu" />

        <Button
            android:id="@+id/btnStopTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Przerwij test" />

        <TextView
            android:id="@+id/textLiveStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="Wyslane: 0  Odebrane: 0  Utracone: 0\nRTT sr.: -- ms   RSSI: -- dBm\nDystans GPS: -- m" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <!-- Eksport -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Adres serwera domowego (IP:port)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editServerAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="192.168.1.100:8765" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnExportServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Wyslij wyniki do serwera domowego" />

        <Button
            android:id="@+id/btnExportShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Udostepnij plik CSV (np. Dysk Google)" />

        <TextView
            android:id="@+id/textLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="" />

    </LinearLayout>
</ScrollView>
